# Copy to .env, chmod 600 .env, and edit locally. Never commit real values.
# The supplied server key belongs in both fields if both servers share that key.
ABENCH_API_KEY=REPLACE_WITH_SERVER_KEY
ABENCH_ADMIN_KEY=REPLACE_WITH_SERVER_KEY

# These addresses work ON the GPU host, or with the two SSH forwards described
# in docs/coworker_setup.md. They are not public model URLs.
ABENCH_LOCAL_URL=http://127.0.0.1:18001
ABENCH_JUDGE_URL=http://127.0.0.1:18003
ABENCH_JUDGE_MODEL=gpt-oss-20b-local

# Optional token for a dataset that requires Hugging Face authentication.
HF_TOKEN=
