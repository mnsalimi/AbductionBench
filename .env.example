# Copy to .env and source it (`set -a; . ./.env; set +a`), or export these in
# your shell.  Config files reference them via ${env:NAME}, so no key is ever
# committed.

# Key accepted by the gateway: either the shared admin key or a per-user
# virtual key (sk-...).  Batch calls through the gateway pass-through accept both.
ABENCH_API_KEY=

# Gateway base URL (model discovery + single calls).  Quick-tunnel URLs rotate;
# the model configs also carry a discovery command that re-reads the current one.
ABENCH_GATEWAY_URL=https://cosmetic-concerns-manor-portions.trycloudflare.com

# Where the native batch route lives.  Same host as the gateway when using its
# pass-through paths (/<model-dir>/v1/chat/completions/batch).
ABENCH_BATCH_URL=https://cosmetic-concerns-manor-portions.trycloudflare.com

# A model's OWN tunnel (only its own vLLM key works there, not virtual keys).
ABENCH_MODEL_TUNNEL_URL=

# The model's real vLLM key, needed only for the direct-tunnel batch route.
ABENCH_ADMIN_KEY=

# Tunnel-free path: the vLLM server itself, when the engine runs on the GPU host
# or through an SSH port-forward.  Avoids the ~100 s Cloudflare request ceiling.
ABENCH_LOCAL_URL=http://127.0.0.1:18004

# Optional: Hugging Face token for gated datasets.
HF_TOKEN=
